// Builds a control flow graph for a function.
class CfgBuilder {
	// override to build a graph out of subclasses carrying consumer state
	var newBlock: int -> CfgBlock = CfgBlock.new;
	var newEdge: (int, CfgBlock, CfgBlock) -> CfgEdge = CfgEdge.new;

	private def bi = BytecodeIterator.new();
	private def ctl_stack = ControlStack<CfgBlock>.new();
	private var entry: CfgBlock;
	private var exit: CfgBlock;

	new() {
		ctl_stack.newLabel = newCfgBlock;
		ctl_stack.mergeBlock = mergeCfgBlock;
		ctl_stack.bindLabel = bindCfgBlock;
	}

	// {exit} is the function's outermost label, which the final `end` targets.
	def build(func: FuncDecl) -> (CfgBlock, CfgBlock) {
		entry = ctl_stack.reset();
		exit = ctl_stack.getEntry(0).label;
		bi.reset(func);
		bi.dispatchLocalDecls(ctl_stack); // advance bi.pc past locals before ctl_stack.pc is read
		while (bi.more()) {
			ctl_stack.pc = bi.pc;
			def before = ctl_stack.block, op = bi.current();
			// an `end` or `loop` is a merge point and belongs to the block it merges into
			def isMerge = op == Opcode.END || op == Opcode.LOOP;
			bi.dispatch(ctl_stack);
			def owner = if(isMerge, ctl_stack.block, before);
			if (owner != null) {
				if (owner.start < 0) owner.start = bi.pc;
				owner.last_instr_pc = bi.pc;
				owner.end = bi.nextPc();
			}
			bi.next();
		}
		return (entry, exit);
	}
	// Removes a block owning no instruction, which has no pc to carry instrumentation and cannot be
	// named by its start, by pointing each predecessor straight at its single successor.
	def spliceEmptyBlocks(entry: CfgBlock, exit: CfgBlock) {
		def blocks = Vector<CfgBlock>.new();
		entry.dfs(blocks.put, null, null);
		for (i < blocks.length) {
			def b = blocks[i];
			if (b == entry || b == exit || b.last_instr_pc >= 0) continue;
			if (b.incoming == null || b.outgoing == null || b.outgoing.tail != null) continue;
			def out = b.outgoing.head, to = out.target;
			for (l = b.incoming; l != null; l = l.tail) {
				def e = l.head, p = e.source;
				// {outgoing} order is the branch's label order, which probes rely on, so splice {e}
				// out in place: only the cells ahead of it are copied, the rest of the list is shared
				var head = p.outgoing, pre: List<CfgEdge>;
				while (head.head != e) {
					pre = List.new(head.head, pre);
					head = head.tail;
				}
				def n = newEdge(e.pc, p, to);
				// {b} forwards unconditionally, so the edge replacing {e} inherits {b}->{to} and
				// becomes the backedge in its place
				n.isBackedge = out.isBackedge;
				var rebuilt = List.new(n, head.tail);
				while (pre != null) {
					rebuilt = List.new(pre.head, rebuilt);
					pre = pre.tail;
				}
				p.outgoing = rebuilt;
				to.incoming = List.new(n, to.incoming);
			}
			// {b}->{to} is orphaned now that nothing reaches {b}
			var keep: List<CfgEdge>;
			for (l = to.incoming; l != null; l = l.tail) {
				if (l.head != out) keep = List.new(l.head, keep);
			}
			to.incoming = keep;
			b.incoming = null;
			b.outgoing = null;
		}
	}
	// Links each block ending in `return` to EXIT, which the CFG leaves without a successor. A block
	// ending in `unreachable` or `throw` traps instead, so it never reaches EXIT and gets no edge.
	def addReturnEdges(func: FuncDecl, entry: CfgBlock, exit: CfgBlock) {
		bi.reset(func);
		// post-order, so the dfs never walks an edge added here
		entry.dfs(null, null, fun (b: CfgBlock) {
			if (b.outgoing != null || b == exit || b.last_instr_pc < 0) return;
			bi.at(b.last_instr_pc, -1);
			match (bi.current()) {
				RETURN, RETURN_CALL, RETURN_CALL_INDIRECT, RETURN_CALL_REF => link(b.last_instr_pc, b, exit);
				_ => ;
			}
		});
	}
	// prepends, so {outgoing} is in reverse branch-label order
	def link(pc: int, from: CfgBlock, to: CfgBlock) -> CfgEdge {
		if (verbose) Trace.OUT.put2("add id:%d -> id:%d", from.id, to.id).ln();
		def e = newEdge(pc, from, to);
		from.outgoing = List.new(e, from.outgoing);
		to.incoming = List.new(e, to.incoming);
		return e;
	}
	private def newCfgBlock(cs: ControlStack<CfgBlock>) -> CfgBlock {
		return if(cs.isUnreachable(), null, newBlock(cs.pc));
	}
	// a deferred edge takes {cs.pc} so that it still belongs to the branch that chose it
	private def mergeCfgBlock(cs: ControlStack<CfgBlock>, from: CfgBlock, to: CfgBlock) -> CfgBlock {
		def wasBackedge = cs.backedge;
		cs.backedge = false; // only the edge created by this call is the backedge
		if (from == null || cs.isUnreachable()) return to;
		// {from} is dead because nothing ever branched to it
		if (from != entry && from.incoming == null) return to;
		def e = link(cs.pc, from, to);
		e.isBackedge = wasBackedge;
		return to;
	}
	private def bindCfgBlock(cs: ControlStack<CfgBlock>, pc: int, label: CfgBlock) {
		if (label == null) return;
		if (pc < 0) pc = bi.nextPc();
		label.bind_pos = pc;
		if (verbose) Trace.OUT.put2("bind id:%d @%d", label.id, pc).ln();
	}
}

def verbose = false;
var labelId = 100;

class CfgEdge(pc: int, source: CfgBlock, target: CfgBlock) {
	var isBackedge: bool; // branches to an enclosing loop label
}

class CfgBlock(decl_pos: int) {
	def id = labelId++;
	var bind_pos: int = -1;
	// the bytecode range [start ... end) this block owns
	var start: int = -1;
	var end: int = -1;
	var last_instr_pc: int = -1; // last instruction this block owns, or < 0 when it owns none
	var outgoing: List<CfgEdge>;
	var incoming: List<CfgEdge>;
	var mark: int;

	def hash() -> int {
		return id;
	}
	def equals(that: CfgBlock) -> bool {
		return this.id == that.id;
	}

	def dfs<R>(pre: CfgBlock -> R, onEdge: CfgEdge -> R, post: CfgBlock -> R) {
		// XXX visited tracks blocks only for the unmarking, since {mark} is the visited check
		def visited = Vector<CfgBlock>.new();

		dfs0(pre, onEdge, post, visited);

		visited.apply(CfgBlock.resetMark);
	}
	private def resetMark() { mark = 0; }
	private def dfs0<R>(pre: CfgBlock -> R, onEdge: CfgEdge -> R, post: CfgBlock -> R, visited: Vector<CfgBlock>) {
		if (mark != 0) return;
		mark = 1;

		visited.put(this);
		if (pre != null) pre(this);
		Lists.apply(outgoing, fun (e: CfgEdge) {
			def child = e.target;

			if (onEdge != null) onEdge(e);
			if (child != null) child.dfs0(pre, onEdge, post, visited);
		});
		if (post != null) post(this);
	}
}
