// Implements a monitor that profiles dynamic execution paths through functions.
def monitor_ = MonitorRegistry.add(
	"path-profile", "Profiles dynamic execution paths through functions.",
	PathProfilingMonitor.new());

class PathProfilingMonitor extends Monitor {
	var module: Module;
	def entries = Vector<PathProfileEntry>.new();
	def cfgBuilder = CfgBuilder.new();

	def onParse(m: Module, err: ErrorGen) {
		module = m;
		for (j < m.functions.length) {
			def func: FuncDecl = m.functions[j];
			if (func.imp != null) continue; // skip imported functions
			def cfgExit = cfgBuilder.build(func);
			def cfg = cfgExit.0, exit = cfgExit.1;

			// (Section 3.1) CFG to DAG

			// skip path numbering for CFGs with backedges (CFG => DAG)
			// TODO implement general CFG -> DAG conversion (Section 4)
			if (hasBackedge(cfg)) continue;

			// (Section 3.2) assign values to edges to make sums across all paths unique

			// Figure 5. Algorithm for assigning values to edges in a Dag.
			assignVals(cfg);

			// (Section 3.3) use spanning trees to select edges to instrument and increment

			// Kruskal's algorithm to find a maximal cost spanning tree of the CFG
			def st: SpanningTree = kruskals(cfg, exit);
			// Determine Increment(e) for each chord in the spanning tree (Ball Fig. 4)
			st.computeIncrements(cfg);

			// (Section 3.4) Figure 8. instrument the edges directly
			placeInit(cfg, st);
			placeCount(exit, st);
			placeDefault(st);

			// place probes, covering the edges each decision dispatches to
			def counts: Array<int> = Array<int>.new(cfg.numPaths); // counts of every path through the function
			placeProbes(m, func, cfg, exit, st, counts);

			entries.put(PathProfileEntry.new(func, cfg, exit, st, counts));
		}
	}
	def onFinish(i: Instance, r: Result) {
		for (j < entries.length) {
			def e = entries[j];
			out.put1("func %q", e.func.render(module.names, _)).ln();
			printCfg(out, e.cfg, e.st);
			// the block sequence each path number denotes, so counts[k] can be read back to a route
			def paths = enumPaths(e.cfg, e.exit, e.counts.length);
			for (k < e.counts.length) {
				out.put2("  counts[%d] = %d", k, e.counts[k]).ln();
				if (paths != null && paths[k] != null) {
					out.puts("      path:");
					for (l = paths[k]; l != null; l = l.tail) out.put1(" %d", l.head);
					out.ln();
				}
			}
		}
	}
}

private class PathProfileEntry(func: FuncDecl, cfg: CfgBlock, exit: CfgBlock, st: SpanningTree, counts: Array<int>) {
	// TODO this counts is caller-independent, where we probably want it also indexed by caller (location)
}

// Val(e) / NumPaths(v) assignment (Ball-Larus). Algorithm for assigning values to edges in a DAG, Fig. 5
// Assigning integer values to edges such that no two paths compute the same path sum: Section 3.2
def assignVals(cfg: CfgBlock) {
	// get reverse topological order
	def order = Vector<CfgBlock>.new();
	cfg.dfs(null, null, order.put);

	// for each vertex v in reverse topological order
	for (i < order.length) {
		def v = order[i];
		// if v is a leaf vertex
		if (v.outgoing == null) {
			v.numPaths = 1;
		} else {
			v.numPaths = 0;
			// for each edge e = v -> w
			Lists.apply(v.outgoing, fun (e: CfgEdge) {
				def w = e.target;
				e.val = v.numPaths;
				v.numPaths = v.numPaths + w.numPaths;
			});
		}
	}
}

// undirected edge candidate for the spanning tree
private class TreeEdge(edge: CfgEdge) {
	def source = edge.source;
	def target = edge.target;
	def weight: int = 1; // Kruskal's maximizes total tree weight, to MINIMIZE total chord cost
	var increment: int; // Increment(e), for chords only (Section 3.3)
	def events: int = edge.val; // Events(f) = Val(f)
	// classification + position within SpanningTree.chords/tree, assigned by kruskals
	var isChord: bool;
	var index: int;
	// instrumentation for this edge
	var action: Action;
}
def hashCfgEdge(e: CfgEdge) -> int { return e.pc; }
def equalsCfgEdge(a: CfgEdge, b: CfgEdge) -> bool { return a == b; }

// T (tree) and E - T (chords)
private class SpanningTree(tree: Array<TreeEdge>, chords: Array<TreeEdge>) {
	// maps a real CfgEdge to its TreeEdge, for O(1) chord/tree classification + index lookup
	def edgeMap = HashMap<CfgEdge, TreeEdge>.new(hashCfgEdge, equalsCfgEdge);
	// blocks which are marked to be instrumented
	// Ball-Larus defines instrumentation along edges, so we attach it to the block in the source
	def instrumented = HashSet<CfgBlock>.new(CfgBlock.hash, CfgBlock.equals);
	new() {
		for (te in tree) edgeMap[te.edge] = te;
		for (te in chords) edgeMap[te.edge] = te;
	}
	// instrument an edge by marking its source block
	def instrument(te: TreeEdge, a: Action) {
		instrumented.add(te.source);
		te.action = a;
	}
	// Algorithm for determining Increment(e) for each chord e using a DFS of spanning tree T of
	// graph G, Fig. 4 (increment loop, DFS, and Dir below are all part of this same algorithm).
	def computeIncrements(entry: CfgBlock) {
		// for each e in E - T do Increment(e) := 0
		for (j < chords.length) chords[j].increment = 0;
		// DFS(0, ENTRY, NULL)
		dfs(0, entry, null);
		// for each e in E - T: 
		for (j < chords.length) {
			def e = chords[j];
			// Increment(e) := Increment(e) + Events(e)
			e.increment = e.increment + e.events;
		}
	}

	// DFS procedure, Fig. 4
	private def dfs(events: int, v: CfgBlock, e: TreeEdge) {
		// for each f in T:
		for (i < tree.length) {
			def f = tree[i];
			// f != e and v = tgt(f)
			if (f != e && v == f.target)
				// DFS(Dir(e,f)*events + Events(f), src(f), f)
				dfs(dir(e, f) * events + f.events, f.source, f);
		}
		// for each f in T:
		for (i < tree.length) {
			def f = tree[i];
			// f != e and v = src(f)
			if (f != e && v == f.source)
				// DFS(Dir(e,f)*events + Events(f), tgt(f), f)
				dfs(dir(e, f) * events + f.events, f.target, f);
		}
		// for each f in E - T:
		for (j < chords.length) {
			def f = chords[j];
			// v = src(f) or v = tgt(f) do Increment(f) := Increment(f) + Dir(e,f)*events
			if (v == f.source || v == f.target) f.increment = f.increment + dir(e, f) * events;
		}
	}
	// Dir function, Fig. 4: 1 if e and f point the same direction (or e is NULL), else -1
	private def dir(e: TreeEdge, other: TreeEdge) -> int {
		// precondition: e and f share a common endpoint
		if (e == null) return 1;
		if (e.source == other.target || e.target == other.source) return 1; // e and f in same direction
		return -1; // e and f in opposite directions
	}
}

// Using a spanning tree to select edges to instrument and compute the appropriate increment
// for each instrumented edge: Section 3.3
// maximum spanning tree (Kruskal's algorithm, via disjoint set) - maximizing tree weight
// minimizes the total weight of the chords left over to instrument
def kruskals(entry: CfgBlock, exit: CfgBlock) -> SpanningTree {
	// V
	def vertices = Vector<CfgBlock>.new();
	// E
	def unsortedEdges = Vector<TreeEdge>.new();
	// initialize V and E
	entry.dfs(
		fun (b: CfgBlock) {
			// V
			vertices.put(b);
			// E
			Lists.apply(b.outgoing, fun (e: CfgEdge) { unsortedEdges.put(TreeEdge.new(e)); });
		},
		null,
		null);

	// disjoint set: each block maps to the set of blocks it belongs to
	def disjointSet = HashMap<CfgBlock, HashSet<CfgBlock>>.new(CfgBlock.hash, CfgBlock.equals);

	// for each vertex v in V
	for (i < vertices.length) {
		// MAKE-SET(v)
		def g = HashSet<CfgBlock>.new(CfgBlock.hash, CfgBlock.equals);
		g.add(vertices[i]);
		disjointSet[vertices[i]] = g;
	}

	// sort E in decreasing order by weight(e)
	def unsorted = unsortedEdges.extract();
	def edges = Arrays.sort(unsorted, 0, unsorted.length,
		fun (x: TreeEdge, y: TreeEdge) => x.weight >= y.weight);

	// T = {}
	def tree = Vector<TreeEdge>.new();
	// E - T
	def chords = Vector<TreeEdge>.new();

	// Seed T with the EXIT->ENTRY edge (cf. "Optimally Profiling and Tracing Programs")
	// to prevent it from being recorded as a chord in the spanning tree
	// detached from both edge lists: it is not part of the CFG, only of the spanning tree
	def exitTreeEdge = TreeEdge.new(CfgEdge.new(-1, exit, entry));
	exitTreeEdge.isChord = false;
	exitTreeEdge.index = tree.length;
	tree.put(exitTreeEdge);
	// UNION(FIND-SET(EXIT), FIND-SET(ENTRY))
	def setExit = disjointSet[exit];
	setExit.add(entry);
	disjointSet[entry] = setExit;

	// for each edge (u,v) in sorted E:
	for (i < edges.length) {
		def te = edges[i], source = te.source, target = te.target;
		def findSetU = disjointSet[source];
		def findSetV = disjointSet[target];
		// if FIND-SET(u) != FIND-SET(v)
		if (findSetU == findSetV) {
			te.isChord = true;
			te.index = chords.length;
			chords.put(te);
		} else {
			// UNION(FIND-SET(u), FIND-SET(v))
			findSetU.adds(findSetV);
			for (v in findSetV.toArray()) disjointSet[v] = findSetU;
			// F := F ∪ { {u, v} }
			te.isChord = false;
			te.index = tree.length;
			tree.put(te);
		}
	}
	// return T, E - T
	return SpanningTree.new(tree.extract(), chords.extract());
}

// runtime actions an edge can carry, executed against the per-activation register {r} and the
// per-function path-count histogram {counts}
private type Action {
	case Nothing;                // no instrumentation placed on this edge (the default)
	case RSet(value: int);       // r = value
	case RAdd(value: int);       // r += value
	case CountR;                 // counts[r]++
	case CountConst(value: int); // counts[value]++
	case CountRPlus(value: int); // counts[r + value]++
}

// Pass 1, Fig. 8: register initialization code
def placeInit(entry: CfgBlock, st: SpanningTree) {
	def ws = Vector<CfgBlock>.new();
	ws.put(entry);
	Vectors.drain(ws, 0, fun (v: CfgBlock) {
		// for each edge e = v -> w
		Lists.apply(v.outgoing, fun (e: CfgEdge) {
			def te = st.edgeMap[e];
			// if e is a chord edge
			if (te.isChord) {
				// instrument(e, 'r=Inc(e)')
				st.instrument(te, Action.RSet(te.increment));
			// else if e is the only incoming edge of w
			} else if (Lists.length(e.target.incoming) == 1) {
				ws.put(e.target);
			} else {
				// instrument(e, 'r=0')
				st.instrument(te, Action.RSet(0));
			}
		});
	});
}

// Pass 2, Fig. 8: memory increment code
def placeCount(exit: CfgBlock, st: SpanningTree) {
	def ws = Vector<CfgBlock>.new();
	ws.put(exit);
	Vectors.drain(ws, 0, fun (w: CfgBlock) {
		// for each edge e = v -> w
		Lists.apply(w.incoming, fun (e: CfgEdge) {
			def te = st.edgeMap[e];
			// if e is a chord edge
			if (te.isChord) {
				// if e's instrumentation is 'r=Inc(e)'
				if (Action.RSet.?(te.action)) {
					// instrument(e, 'count[Inc(e)]++')
					st.instrument(te, Action.CountConst(te.increment));  // this is an optimization
				} else {
					// instrument(e, 'count[r+Inc(e)]++')
					st.instrument(te, Action.CountRPlus(te.increment));
				}
			} else {
				def v = te.source;
				// else if e is the only outgoing edge of v
				if (Lists.length(v.outgoing) == 1) {
					ws.put(v);
				// else
				} else {
					// instrument(e, 'count[r]++')
					st.instrument(te, Action.CountR);
				}
			}
		});
	});
}
// Pass 3, Fig. 8: register increment code
def placeDefault(st: SpanningTree) {
	// for all uninstrumented chords c
	for (i < st.chords.length) {
		def te = st.chords[i];
		if (Action.Nothing.?(te.action)) {
			// instrument(e, 'r+=Inc(e)')
			st.instrument(te, Action.RAdd(te.increment));
		}
	}
}
// runs whatever Fig. 8 instrumented onto {te}, at the instruction that owns it
def execEdge(reg: RegState, te: TreeEdge, counts: Array<int>) {
	match (te.action) {
		Nothing => ;
		RSet(value) => reg.r = value;
		RAdd(value) => reg.r = reg.r + value;
		CountR => counts[reg.r] = counts[reg.r] + 1;
		CountConst(value) => counts[value] = counts[value] + 1;
		CountRPlus(value) => counts[reg.r + value] = counts[reg.r + value] + 1;
	}
}
// {r} is the running path register for one function; recursive re-entry pushes the caller's {r}
// onto {stack} and pops it back on return, since {r} is shared per function rather than per call
// activation.
private class RegState {
	var r: int;
	var active: bool;
	def stack = ArrayStack<int>.new();
	// recursive re-entry: save the caller's {r} before resetting for this activation
	def enter() {
		if (active) stack.push(r);
		r = 0;
		active = true;
	}
	// restore the caller's {r}, or mark inactive if this was the outermost activation
	def leave() {
		if (!stack.empty()) {
			r = stack.pop();
		} else {
			active = false;
		}
	}
}

// place all real instrumentation for one acyclic function. Every block owns an instruction control
// cannot reach without entering it ({last_instr_pc}), so each block's outgoing edge(s) are
// instrumented right there — exactly where Fig. 8 says, with nothing folded elsewhere. Runs BEFORE
// the Fig. 8 passes: probes reference edges, so whatever those passes instrument is picked up with
// no second pass to rebuild anything.
def placeProbes(m: Module, func: FuncDecl, entry: CfgBlock, exit: CfgBlock, st: SpanningTree, counts: Array<int>) {
	def reg = RegState.new(); // register for `r`

	// insert entry probes
	Instrumentation.insertFuncEntryProbe(m, func.func_index, EntryProbe.new(reg));

	// insert exit probes. The EXIT->ENTRY edge is seeded into T (see kruskals), so it is never a
	// chord and has no Increment to apply here -- this probe only restores {r} for a recursive
	// caller. Placed at every real return site plus the final byte, so exactly one fires per
	// activation (a br out of the body lands on that final `end`).
	def exitProbe = ExitProbe.new(reg);
	def bi = BytecodeIterator.new().reset(func);
	while (bi.more()) {
		match (bi.current()) {
			RETURN, RETURN_CALL, RETURN_CALL_INDIRECT, RETURN_CALL_REF =>
				Instrumentation.insertLocalProbe(m, func.func_index, bi.pc, exitProbe);
			_ => ;
		}
		bi.next();
	}
	Instrumentation.insertLocalProbe(m, func.func_index, func.cur_bytecode.length - 1, exitProbe);

	// instrument blocks that were marked for instrumentation
	def blocks = st.instrumented.toArray();
	for (i < blocks.length) {
		def b = blocks[i];
		def n = Lists.length(b.outgoing);
		if (n == 0) continue; // EXIT
		if (n == 1) {
			// entering {b} already commits to its one edge; no operand to read
			def te = st.edgeMap[b.outgoing.head];
			Instrumentation.insertLocalProbe(m, func.func_index, b.last_instr_pc, EdgeProbe.new(reg, te, counts));
			continue;
		}
		// a decision: {last_instr_pc} is the branch itself, which says what kind of probe it needs
		bi.at(b.last_instr_pc, -1);
		if (bi.current() == Opcode.BR_TABLE) {
			// every label is a direct edge out of {b} (Section 3.1's CFG->DAG fix); goto() prepends,
			// so {b.outgoing} is in reverse label order
			def labels = bi.immptr().read_labels().length;
			def dispatch = Array<TreeEdge>.new(labels);
			var idx = labels - 1;
			for (l = b.outgoing; l != null; l = l.tail) dispatch[idx--] = st.edgeMap[l.head];
			Instrumentation.insertLocalProbe(m, func.func_index, b.last_instr_pc, TableProbe.new(reg, dispatch, counts));
		} else {
			def falseEdge = st.edgeMap[b.outgoing.head];
			def trueEdge = st.edgeMap[b.outgoing.tail.head];
			Instrumentation.insertLocalProbe(m, func.func_index, b.last_instr_pc, BoolProbe.new(reg, falseEdge, trueEdge, counts));
		}
	}
}
private class EntryProbe(reg: RegState) extends Probe {
	def fire(loc: DynamicLoc) -> ProbeAction {
		reg.enter();
		return ProbeAction.Continue;
	}
}
// the EXIT vertex: restores {r} for a recursive caller. Carries no Fig. 8 instrumentation -- the
// EXIT->ENTRY edge is seeded into the spanning tree, so it is never a chord.
private class ExitProbe(reg: RegState) extends Probe {
	def fire(loc: DynamicLoc) -> ProbeAction {
		reg.leave();
		return ProbeAction.Continue;
	}
}
// a block whose single outgoing edge is taken whenever the block is entered
private class EdgeProbe(reg: RegState, te: TreeEdge, counts: Array<int>) extends Probe {
	def fire(loc: DynamicLoc) -> ProbeAction {
		execEdge(reg, te, counts);
		return ProbeAction.Continue;
	}
}
private class BoolProbe(reg: RegState, falseEdge: TreeEdge, trueEdge: TreeEdge, counts: Array<int>) extends Probe {
	def fire(loc: DynamicLoc) -> ProbeAction {
		def v = Values.unbox_u(loc.frame.getFrameAccessor().getOperand(0));
		execEdge(reg, if(v != 0, trueEdge, falseEdge), counts);
		return ProbeAction.Continue;
	}
}
private class TableProbe(reg: RegState, dispatch: Array<TreeEdge>, counts: Array<int>) extends Probe {
	def fire(loc: DynamicLoc) -> ProbeAction {
		def v = Values.unbox_u(loc.frame.getFrameAccessor().getOperand(0));
		def idx = if(v >= u32.!(dispatch.length), dispatch.length - 1, int.!(v));
		execEdge(reg, dispatch[idx], counts);
		return ProbeAction.Continue;
	}
}

// Enumerate every ENTRY->EXIT path, indexed by its path number -- the sum of Val along it, which is
// exactly the index the runtime increments. Returns null if the function has more paths than are
// worth listing (the walk visits each path once, so its cost is the path count).
def MAX_PATHS_TO_LIST = 1024;
def enumPaths(entry: CfgBlock, exit: CfgBlock, numPaths: int) -> Array<List<int>> {
	if (numPaths <= 0 || numPaths > MAX_PATHS_TO_LIST) return null;
	def out = Array<List<int>>.new(numPaths);
	walkPath(entry, exit, 0, null, out);
	return out;
}
def walkPath(v: CfgBlock, exit: CfgBlock, sum: int, acc: List<int>, out: Array<List<int>>) {
	def here = List.new(v.id, acc);
	if (v == exit) {
		if (sum >= 0 && sum < out.length) out[sum] = Lists.reverse(here);
		return;
	}
	for (l = v.outgoing; l != null; l = l.tail) {
		def e = l.head;
		walkPath(e.target, exit, sum + e.val, here, out);
	}
}

// CFG + val(e) printing
def printCfg(out: TraceBuilder, entry: CfgBlock, st: SpanningTree) {
	def touched = Vector<CfgBlock>.new();
	printCfgRec(out, entry, st, touched);
	for (i < touched.length) touched[i].mark = 0;
}
def printCfgRec(out: TraceBuilder, b: CfgBlock, st: SpanningTree, touched: Vector<CfgBlock>) {
	if (b == null || b.mark != 0) return;
	b.mark = 1;
	touched.put(b);
	// {last_instr_pc} is the instruction this block owns -- where its outgoing edges are probed
	out.put2("  block %d pc=%d", b.id, b.last_instr_pc).ln();
	// print all of this block's own edges first, so they aren't interleaved
	// with a deeper block's edges once we recurse
	Lists.apply(b.outgoing, fun (e: CfgEdge) {
		def te = st.edgeMap[e];
		// Increment(e) is defined for chords only; a tree edge carries none
		if (te != null && te.isChord) {
			out.put3("    -> block %d val=%d inc=%d", e.target.id, e.val, te.increment).ln();
		} else {
			out.put2("    -> block %d val=%d", e.target.id, e.val).ln();
		}
	});
	Lists.apply(b.outgoing, fun (e: CfgEdge) { printCfgRec(out, e.target, st, touched); });
}

// backedge detection
def hasBackedge(b: CfgBlock) -> bool {
	if (b == null) return false;
	def found = Box<bool>.new();
	Lists.apply(b.outgoing, fun (e: CfgEdge) {
		def target = e.target;
		if (target == null) return;
		if (target.bind_pos >= 0 && target.bind_pos < e.pc) {
			found.put(true);
			return;
		}
		if (hasBackedge(target)) found.put(true);
	});
	return found.data;
}

private class Box<T> {
	def var data: T;
	def put(e: T) {
		data = e;
	}
}

