// Traces individual stack-switching events in execution order.
def monitor_ = MonitorRegistry.add(
	"ssevent", "Traces stack-switching events (suspend/switch/resume) as an ordered table.",
	StackSwitchEventMonitor.new());

// The kinds of stack-switching opcodes that the monitor observes. {cont.new} and {cont.bind}
// create continuations rather than transferring control, so they are counted but not traced.
enum StackSwitchOpcode(mnemonic: string, traced: bool) {
	CONT_NEW	("cont.new", false),
	CONT_BIND	("cont.bind", false),
	SUSPEND		("suspend", true),
	RESUME		("resume", true),
	RESUME_THROW	("resume_throw", true),
	RESUME_THROW_REF("resume_throw_ref", true),
	SWITCH		("switch", true)
}

// Returns the number of parameters carried by the tag at index {tag} in {module},
// or -1 if {tag} is negative (e.g. a resume-family opcode) or out of range.
def tagParamCount(module: Module, tag: int) -> int {
	if (tag < 0) return -1;
	if (u32.view(tag) >= module.tags.length) return -1;
	return module.tags[tag].fields.length;
}

// A stack-switching site: its static fields are constant for a given program-counter.
// Cannot extend {CountProbe}, because SPC intrinsifies count probes without checking for an
// overridden {fire}, which would drop the events this site records.
// One executed transfer. The fields below are filled in when control lands.
class TransferEvent(site: EventSite, gap: u64, start: u64) {
	var dest_func = -1;
	var dest_pc = -1;
	var cycles: u64;
}

class EventSite(stats: TransferStats, gapProbe: GapProbe, func_index: int, pc: int, op: StackSwitchOpcode, tag: int, params: int) extends Probe {
	var count: u64;
	var landed: u64;	// executions whose destination was observed; the last one of a run is not
	// Where control landed after this site executed, with a count per destination.
	def dests = Vector<(int, int, u64)>.new();

	def fire(dynamicLoc: DynamicLoc) -> ProbeAction {
		// The global GapProbe fires first and has already counted this op instruction, thus {gap - 1}.
		var e = TransferEvent.new(this, gapProbe.gap - 1, Target.rdtsc());
		stats.events.put(e);
		count++;
		gapProbe.gap = 0;
		gapProbe.pending = e; // the next instruction executed is this transfer's destination
		return ProbeAction.Continue;
	}
	// Records that control landed at {pc} in {func_index} after this site executed.
	def recordDest(func_index: int, pc: int) {
		landed++;
		for (i < dests.length) {
			var d = dests[i];
			if (d.0 == func_index && d.1 == pc) {
				dests[i] = (d.0, d.1, d.2 + 1);
				return;
			}
		}
		dests.put((func_index, pc, 1));
	}
}

// A site of an opcode that is counted but not traced. Adds no behavior to {CountProbe}, so SPC
// can intrinsify it.
class CountSite(func_index: int, pc: int, op: StackSwitchOpcode, tag: int) extends CountProbe { }

// Static layout for the event table. Shared by the text and CSV renderers.
def eventTable = initEventTable();
def initEventTable() -> TraceTable {
	var t = TraceTable.new(["#", "Function", "PC", "Opcode", "Tag", "Params", "ToFunction", "ToPC", "Kind", "Cycles", "Gap"]);
	t.cells[0].set(6,  Justification.RIGHT, Color.NONE);
	t.cells[1].set(10, Justification.RIGHT, Color.NONE);
	t.cells[2].set(6,  Justification.RIGHT, Color.NONE);
	t.cells[3].set(18, Justification.LEFT,  Color.NONE);
	t.cells[4].set(5,  Justification.RIGHT, Color.NONE);
	t.cells[5].set(7,  Justification.RIGHT, Color.NONE);
	t.cells[6].set(11, Justification.RIGHT, Color.NONE);
	t.cells[7].set(6,  Justification.RIGHT, Color.NONE);
	t.cells[8].set(12, Justification.LEFT,  Color.NONE);
	t.cells[9].set(9,  Justification.RIGHT, Color.NONE);
	t.cells[10].set(9, Justification.RIGHT, Color.NONE);
	return t;
}

// Single global probe: fires on every executed instruction and only counts it. Event
// recording is handled by per-site local probes ({EventSite}), so this needs no site lookup.
class GapProbe extends Probe {
	var gap: u64; // Num. instructions executed since the last stack-switching op.
	var pending: TransferEvent; // set by a site that just transferred; the next instruction is its destination.

	def fire(dynamicLoc: DynamicLoc) -> ProbeAction {
		gap++;
		if (pending != null) {
			var e = pending;
			pending = null;
			e.cycles = Target.rdtsc() - e.start;
			e.dest_func = dynamicLoc.func.decl.func_index;
			e.dest_pc = dynamicLoc.pc;
			e.site.recordDest(e.dest_func, e.dest_pc);
		}
		return ProbeAction.Continue;
	}
}

// Installs an {EventSite} local probe at each stack-switching opcode.
class EventSiteVisitor extends BytecodeInstrumenter {
	def stats: TransferStats;

	new(stats, module: Module) super(module) { }

	// Records the first pc of each function, to recognize a continuation starting up.
	def onFunc(func: FuncDecl) {
		var it = BytecodeIterator.new().reset(func);
		it.current(); // decodes the first instruction, moving {pc} past the locals declaration
		stats.recordEntryPc(func.func_index, it.pc);
	}

	def add(op: StackSwitchOpcode, tag: int) {
		stats.static_count[op.tag]++;
		// A suspended stack resumes at the instruction after the one that left it.
		if (op == StackSwitchOpcode.SUSPEND || op == StackSwitchOpcode.SWITCH) {
			stats.resume_pcs.put((bi.func.func_index, bi.nextPc()));
		}
		var site = EventSite.new(stats, stats.gapProbe,
			bi.func.func_index, bi.pc, op, tag, tagParamCount(module, tag));
		stats.event_sites.put(site);
		insertProbeHere(site);
	}
	// Adds a traced site and tallies the handler clauses the resume site installs.
	def addResume(op: StackSwitchOpcode, tag: int, handlers: Range<SuspensionHandler>) {
		add(op, tag);
		for (h in handlers) {
			match (h) {
				Suspend(tag_index, depth) => stats.recordClause(int.view(tag_index), false);
				Switch(tag_index) => stats.recordClause(int.view(tag_index), true);
			}
		}
	}
	// Adds a count-only site for an opcode that is not traced.
	def count(op: StackSwitchOpcode) {
		stats.static_count[op.tag]++;
		var site = CountSite.new(bi.func.func_index, bi.pc, op, -1);
		stats.count_sites.put(site);
		insertProbeHere(site);
	}

	def visit_CONT_NEW(cont: u31) { count(StackSwitchOpcode.CONT_NEW); }
	def visit_CONT_BIND(in_cont: u31, out_cont: u31) { count(StackSwitchOpcode.CONT_BIND); }
	def visit_SUSPEND(tag: u31) { add(StackSwitchOpcode.SUSPEND, int.view(tag)); }
	def visit_SWITCH(cont: u31, tag: u31) { add(StackSwitchOpcode.SWITCH, int.view(tag)); }
	def visit_RESUME(cont: u31, handlers: Range<SuspensionHandler>) { addResume(StackSwitchOpcode.RESUME, -1, handlers); }
	def visit_RESUME_THROW(cont: u31, tag: u31, handlers: Range<SuspensionHandler>) { addResume(StackSwitchOpcode.RESUME_THROW, int.view(tag), handlers); }
	def visit_RESUME_THROW_REF(cont: u31, handlers: Range<SuspensionHandler>) { addResume(StackSwitchOpcode.RESUME_THROW_REF, -1, handlers); }
}

// Everything the probes record and the report reads. Probes hold this rather than the monitor.
class TransferStats {
	def gapProbe = GapProbe.new();
	def events = Vector<TransferEvent>.new();
	def static_count = Array<u64>.new(StackSwitchOpcode.count);
	def event_sites = Vector<EventSite>.new();
	def count_sites = Vector<CountSite>.new();
	def resume_pcs = Vector<(int, int)>.new();	// (function, pc) a suspended stack resumes at
	def entry_pcs = Vector<int>.new();	// first pc of each function, -1 if unknown
	def clause_on = Vector<u64>.new();	// resume sites with an (on $tag $label) clause
	def clause_switch = Vector<u64>.new();	// resume sites with an (on $tag switch) clause

	// Sizes the per-function and per-tag tables once for {module}. {Vector.set} grows to the
	// exact index, so growing on demand would copy once per function; this grows once.
	def sizeFor(module: Module) {
		entry_pcs.grow(module.functions.length);
		for (i = entry_pcs.length; i < module.functions.length; i++) entry_pcs.set(i, -1);
		clause_on.grow(module.tags.length);
		clause_switch.grow(module.tags.length);
	}
	def recordEntryPc(func_index: int, pc: int) {
		entry_pcs.set(func_index, pc);
	}
	// Classifies where a transfer landed. The first two are recognized from the destination
	// alone; the rest follow from the opcode that left, since only some can land in a handler.
	def destKind(op: StackSwitchOpcode, func_index: int, pc: int) -> string {
		if (func_index < 0) return "-";
		if (func_index < entry_pcs.length && entry_pcs[func_index] == pc) return "entry";
		for (i < resume_pcs.length) {
			var r = resume_pcs[i];
			if (r.0 == func_index && r.1 == pc) return "resumption";
		}
		// A {switch} transfers into its target continuation, so it never lands in an {on} clause.
		match (op) {
			SUSPEND => return "handler";				// caught by an {on} clause
			RESUME_THROW, RESUME_THROW_REF => return "catch";	// caught inside the continuation
			_ => return "unknown";
		}
	}
	// Records one handler clause installed by a resume site. The tag index is bounded by the
	// module's tag count, which {sizeFor} has already allocated for.
	def recordClause(tag: int, is_switch: bool) {
		if (tag < 0) return;
		var v = if(is_switch, clause_switch, clause_on);
		v.set(tag, v.get(tag) + 1);
	}

	// Collects every site with a non-zero dynamic count, hottest first.
	def hotSites() -> Array<(int, int, StackSwitchOpcode, int, u64)> {
		var v = Vector<(int, int, StackSwitchOpcode, int, u64)>.new();
		for (i < event_sites.length) {
			var s = event_sites[i];
			if (s.count > 0) v.put((s.func_index, s.pc, s.op, s.tag, s.count));
		}
		for (i < count_sites.length) {
			var s = count_sites[i];
			if (s.count > 0) v.put((s.func_index, s.pc, s.op, s.tag, s.count));
		}
		var array = v.extract();
		return Arrays.sort(array, 0, array.length, hotter);
	}
	// Dynamic executions of {op}, summed over its sites.
	def dynamicCount(op: StackSwitchOpcode) -> u64 {
		var sum = 0uL;
		for (i < event_sites.length) if (event_sites[i].op == op) sum += event_sites[i].count;
		for (i < count_sites.length) if (count_sites[i].op == op) sum += count_sites[i].count;
		return sum;
	}

}

class StackSwitchEventMonitor extends Monitor {
	def stats = TransferStats.new();
	var globalProbeRegistered: bool;

	def onParse(m: Module, err: ErrorGen) {
		stats.sizeFor(m);
		EventSiteVisitor.new(stats, m).run();
		if (!globalProbeRegistered) {
			Instrumentation.insertGlobalProbe(stats.gapProbe);
			globalProbeRegistered = true;
		}
	}

	def onFinish(i: Instance, r: Result) {
		if (MonitorOptions.CSV.val) reportCSV(out, stats.events);
		else reportText(out, stats);
		// This runs once per instantiation, per --repeat iteration and per spectest invoke, so
		// a transfer left dangling here must not be resolved by the next run's first instruction.
		stats.gapProbe.pending = null;
		stats.gapProbe.gap = 0;
	}
}

def hotter(a: (int, int, StackSwitchOpcode, int, u64), b: (int, int, StackSwitchOpcode, int, u64)) -> bool {
	return a.4 > b.4;
}

def siteTable = initSiteTable();
def initSiteTable() -> TraceTable {
	var t = TraceTable.new(["Function", "PC", "Tag", "Count"]);
	t.cells[0].set(10, Justification.RIGHT, Color.NONE);
	t.cells[1].set(6,  Justification.RIGHT, Color.NONE);
	t.cells[2].set(6,  Justification.RIGHT, Color.NONE);
	t.cells[3].set(12, Justification.RIGHT, Color.NONE);
	return t;
}

def reportSites(out: TraceBuilder, stats: TransferStats) {
	var sites = stats.hotSites();
	if (sites.length == 0) return;
	var C = siteTable.cells;
	C[0].color = Color.FUNC;
	C[1].color = Color.LINE;
	C[2].color = Color.TYPE;
	C[3].color = Color.COUNT;
	out.ln().beginColor(Color.UNDERLINE).puts("ssevent: hottest stack-switching sites").endColors().ln();
	// {sites} is sorted hottest-first, so each opcode's rows stay in that order.
	for (op in StackSwitchOpcode) {
		var any = false;
		for (s in sites) {
			if (s.2 != op) continue;
			if (!any) {
				out.puts(op.mnemonic).puts(":").ln();
				siteTable.putTableHeader(out);
				any = true;
			}
			siteTable.cells[0].putd(s.0);
			siteTable.cells[1].putd(s.1);
			siteTable.cells[2].putd(s.3);
			siteTable.cells[3].putd(s.4);
			siteTable.putTableRow(out);
		}
		if (any) out.flush();
	}
}

def destTable = initDestTable();
def initDestTable() -> TraceTable {
	var t = TraceTable.new(["Function", "PC", "Kind", "Count", "Percent"]);
	t.cells[0].set(10, Justification.RIGHT, Color.NONE);
	t.cells[1].set(6,  Justification.RIGHT, Color.NONE);
	t.cells[2].set(12, Justification.LEFT,  Color.NONE);
	t.cells[3].set(12, Justification.RIGHT, Color.NONE);
	t.cells[4].set(10, Justification.RIGHT, Color.NONE);
	return t;
}

// Reports where control landed after each transfer: for a suspension, the handler that caught
// it; for a switch or resume, the first instruction run on the target stack.
def reportDests(out: TraceBuilder, stats: TransferStats) {
	var any = false;
	for (i < stats.event_sites.length) {
		if (stats.event_sites[i].count > 0) any = true;
	}
	if (!any) return;
	var C = destTable.cells;
	C[0].color = Color.FUNC;
	C[1].color = Color.LINE;
	C[2].color = Color.TYPE;
	C[3].color = Color.COUNT;
	C[4].color = Color.COUNT;
	out.ln().beginColor(Color.UNDERLINE).puts("ssevent: transfer destinations").endColors().ln();
	for (i < stats.event_sites.length) {
		var s = stats.event_sites[i];
		if (s.count == 0) continue;
		// Source line, then one row per distinct destination of this site.
		out.puts("func ").putd(s.func_index).puts(" +").putd(s.pc).puts(" ").puts(s.op.mnemonic);
		if (s.tag >= 0) out.puts(" tag ").putd(s.tag);
		out.puts(" -> ").putd(s.dests.length).puts(if(s.dests.length == 1, " target", " targets")).ln();
		if (s.dests.length == 0) continue;
		destTable.putTableHeader(out);
		for (j < s.dests.length) {
			var d = s.dests[j];
			destTable.cells[0].putd(d.0);
			destTable.cells[1].putd(d.1);
			destTable.cells[2].puts(stats.destKind(s.op, d.0, d.1));
			destTable.cells[3].putd(d.2);
			TraceUtil.renderPercent(destTable.cells[4], long.view(d.2), long.view(s.landed), 2);
			destTable.putTableRow(out);
		}
		out.flush();
	}
}

def tagTable = initTagTable();
def initTagTable() -> TraceTable {
	var t = TraceTable.new(["Tag", "Params", "Sites", "Count", "OnTag", "OnSw"]);
	t.cells[0].set(6,  Justification.RIGHT, Color.NONE);
	t.cells[1].set(8,  Justification.RIGHT, Color.NONE);
	t.cells[2].set(7,  Justification.RIGHT, Color.NONE);
	t.cells[3].set(12, Justification.RIGHT, Color.NONE);
	t.cells[4].set(7,  Justification.RIGHT, Color.NONE);
	t.cells[5].set(6,  Justification.RIGHT, Color.NONE);
	return t;
}

// Tallies the sites and dynamic events carrying each tag. Only {suspend}, {switch} and
// {resume_throw} name a tag; the other opcodes record -1 and are skipped.
// A {resume_throw} names an exception tag, which shares an index space with suspension tags but
// is not one, so its sites are left out of this table.
def namesSuspensionTag(s: EventSite) -> bool {
	return s.tag >= 0 && s.op != StackSwitchOpcode.RESUME_THROW;
}

def reportTags(out: TraceBuilder, stats: TransferStats) {
	var max_tag = -1;
	for (i < stats.event_sites.length) {
		var s = stats.event_sites[i];
		if (namesSuspensionTag(s) && s.tag > max_tag) max_tag = s.tag;
	}
	if (stats.clause_on.length - 1 > max_tag) max_tag = stats.clause_on.length - 1;
	if (stats.clause_switch.length - 1 > max_tag) max_tag = stats.clause_switch.length - 1;
	if (max_tag < 0) return;
	var counts = Array<u64>.new(max_tag + 1);
	var sites = Array<u64>.new(max_tag + 1);
	var params = Array<int>.new(max_tag + 1);
	for (i < stats.event_sites.length) {
		var s = stats.event_sites[i];
		if (!namesSuspensionTag(s)) continue;
		counts[s.tag] += s.count;
		sites[s.tag]++;
		params[s.tag] = s.params;
	}
	var C = tagTable.cells;
	C[0].color = Color.TYPE;
	C[2].color = Color.INACTIVE;	// static: sites naming the tag
	C[3].color = Color.COUNT;	// dynamic
	C[4].color = Color.INACTIVE;	// static: on clauses
	C[5].color = Color.INACTIVE;	// static: on-switch clauses
	out.ln().beginColor(Color.UNDERLINE).puts("ssevent: tag usage").endColors().ln();
	tagTable.putTableHeader(out);
	for (tag < counts.length) {
		var on = stats.clause_on.get(tag), sw = stats.clause_switch.get(tag);
		if (sites[tag] == 0 && on == 0 && sw == 0) continue;
		tagTable.cells[0].putd(tag);
		tagTable.cells[1].putd(params[tag]);
		tagTable.cells[2].putd(sites[tag]);
		tagTable.cells[3].putd(counts[tag]);
		tagTable.cells[4].putd(on);
		tagTable.cells[5].putd(sw);
		tagTable.putTableRow(out);
	}
	out.flush();
}

def countTable = initCountTable();
def initCountTable() -> TraceTable {
	var t = TraceTable.new(["Opcode", "static", "dynamic"]);
	t.cells[0].set(18, Justification.LEFT,  Color.NONE);
	t.cells[1].set(8,  Justification.RIGHT, Color.NONE);
	t.cells[2].set(12, Justification.RIGHT, Color.NONE);
	return t;
}

def reportCounts(out: TraceBuilder, stats: TransferStats) {
	var C = countTable.cells;
	C[0].color = Color.INSTR;
	C[1].color = Color.INACTIVE;	// static
	C[2].color = Color.COUNT;	// dynamic
	countTable.putTableHeader(out);
	for (op in StackSwitchOpcode) {
		if (stats.static_count[op.tag] == 0) continue;
		countTable.cells[0].puts(op.mnemonic);
		countTable.cells[1].putd(stats.static_count[op.tag]);
		countTable.cells[2].putd(stats.dynamicCount(op));
		countTable.putTableRow(out);
	}
	out.flush();
}

// Fills the shared event-table cells for one event, numerically (so the text and CSV
// renderers produce identical values).
def fillRow(i: int, e: TransferEvent) {
	var s = e.site;
	eventTable.cells[0].putd(i + 1);
	eventTable.cells[1].putd(s.func_index);
	eventTable.cells[2].putd(s.pc);
	eventTable.cells[3].puts(s.op.mnemonic);
	eventTable.cells[4].putd(s.tag);     // -1 when the opcode names no tag
	eventTable.cells[5].putd(s.params);  // -1 when the opcode names no tag
	eventTable.cells[6].putd(e.dest_func); // -1 if control never landed
	eventTable.cells[7].putd(e.dest_pc);
	eventTable.cells[8].puts(s.stats.destKind(s.op, e.dest_func, e.dest_pc));
	eventTable.cells[9].putd(e.cycles);
	eventTable.cells[10].putd(e.gap);
}

def reportText(out: TraceBuilder, stats: TransferStats) {
	def events = stats.events;
	out.beginColor(Color.UNDERLINE).puts("ssevent: stack-switching instruction counts").endColors().ln();
	reportCounts(out, stats);
	reportSites(out, stats);
	reportTags(out, stats);
	reportDests(out, stats);
	var C = eventTable.cells;
	C[1].color = Color.FUNC;
	C[2].color = Color.LINE;
	C[3].color = Color.INSTR;
	C[4].color = Color.TYPE;
	C[6].color = Color.FUNC;
	C[7].color = Color.LINE;
	C[8].color = Color.TYPE;
	C[9].color = Color.COUNT;
	C[10].color = Color.COUNT;
	out.ln().beginColor(Color.UNDERLINE).puts("ssevent: stack-switching event trace").endColors().ln();
	if (events.length == 0) {
		out.puts("  (no stack-switching events were executed)").ln();
		return;
	}
	eventTable.putTableHeader(out);
	out.flush();
	for (i < events.length) {
		fillRow(i, events[i]);
		eventTable.putTableRow(out);
		out.flush();
	}
	out.ln();
}

def reportCSV(out: TraceBuilder, events: Vector<TransferEvent>) {
	eventTable.putCsvHeader(out);
	for (i < events.length) {
		fillRow(i, events[i]);
		eventTable.putCsvRow(out);
	}
}
