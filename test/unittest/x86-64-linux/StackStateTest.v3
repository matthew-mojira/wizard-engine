// Tests the {StackState} of a stack that resumed a child, once control comes back to it.

def X_ = TestTiers.addTests2([
	("stack_state_returns", StackStateTester.new, test_returns),
	("stack_state_throws", StackStateTester.new, test_throws),
	("stack_state_throws_ref", StackStateTester.new, test_throws_ref),
	("stack_state_host_throws", StackStateTester.new, test_host_throws)
]);

private class StackStateTester(t: Tester, tiering: ExecutionStrategy) {
	def states = Vector<StackState>.new();
	var instance: Instance;

	// Calls function {index} of {STACK_STATE_MODULE} and checks that its stack was RUNNING when it
	// called "check".
	def run(index: int) {
		Execute.tiering = tiering;
		var err = ErrorGen.new("STACK_STATE_MODULE");
		var bp = BinParser.new(Extension.set.all, Limits.new().set(Extension.set.all), err, "STACK_STATE_MODULE");
		bp.tiering = tiering;
		var module = bp.push(STACK_STATE_MODULE, 0, STACK_STATE_MODULE.length).finish();
		if (!err.ok()) {
			t.fail(err.error_msg);
			return;
		}
		var check = HostFunction.new("check", SigCache.v_v, record);
		var host_throw = HostFunction.new("throw", SigCache.v_v, throwTag);
		instance = Instantiator.new(Extension.set.all, module, [check, host_throw], err).run();
		if (!err.ok()) {
			t.fail(err.error_msg);
			return;
		}
		tiering.onTestModule(module);
		var r = Execute.call(instance.functions[index], Values.NONE);
		if (!r.equals(Result.Value(Values.NONE))) {
			t.fail1("expected no results, got %q", r.render);
			return;
		}
		if (states.length != 1) {
			t.fail1("expected one call to check, got %d", states.length);
			return;
		}
		if (states[0] != StackState.RUNNING) t.fail1("expected RUNNING, got %s", states[0].name);
	}
	// Records the state of the current stack.
	def record(args: Range<Value>) -> HostResult {
		states.put(X86_64Runtime.curStack.state());
		return HostResult.Value0;
	}
	// Throws an exception with the module's tag.
	def throwTag(args: Range<Value>) -> HostResult {
		return HostResult.Throw(Exception.new(instance.tags[0], Values.NONE, null));
	}
}

def test_returns(t: StackStateTester) {
	t.run(6);
}
def test_throws(t: StackStateTester) {
	t.run(7);
}
def test_throws_ref(t: StackStateTester) {
	t.run(8);
}
def test_host_throws(t: StackStateTester) {
	t.run(9);
}

// (module
//   (type $f (func))
//   (type $c (cont $f))
//   (tag $e)
//   (import "t" "check" (func $check))
//   (import "t" "throw" (func $host_throw))
//   (func $ret)
//   (func $throw (throw $e))
//   (func $throw_ref
//     (block $h (result exnref)
//       (try_table (catch_all_ref $h) (throw $e))
//       (unreachable))
//     (throw_ref))
//   (func $calls_host (call $host_throw))
//   (elem declare func $ret $throw $throw_ref $calls_host)
//   ;; A child returns to its parent.
//   (func (export "returns")
//     (resume $c (cont.new $c (ref.func $ret)))
//     (call $check))
//   ;; A child throws an exception that its parent catches.
//   (func (export "throws")
//     (block $h
//       (try_table (catch $e $h)
//         (resume $c (cont.new $c (ref.func $throw)))))
//     (call $check))
//   ;; A child rethrows an exception with throw_ref, and its parent catches it.
//   (func (export "throws_ref")
//     (block $h
//       (try_table (catch $e $h)
//         (resume $c (cont.new $c (ref.func $throw_ref)))))
//     (call $check))
//   ;; A child calls a host function that throws an exception, and its parent catches it.
//   (func (export "host_throws")
//     (block $h
//       (try_table (catch $e $h)
//         (resume $c (cont.new $c (ref.func $calls_host)))))
//     (call $check))
// )
def STACK_STATE_MODULE: Array<byte> = [
	0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x06, 0x02, 0x60, 0x00, 0x00, 0x5d, 0x00,
	0x02, 0x15, 0x02, 0x01, 0x74, 0x05, 0x63, 0x68, 0x65, 0x63, 0x6b, 0x00, 0x00, 0x01, 0x74, 0x05,
	0x74, 0x68, 0x72, 0x6f, 0x77, 0x00, 0x00, 0x03, 0x09, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
	0x00, 0x00, 0x0d, 0x03, 0x01, 0x00, 0x00, 0x07, 0x2f, 0x04, 0x07, 0x72, 0x65, 0x74, 0x75, 0x72,
	0x6e, 0x73, 0x00, 0x06, 0x06, 0x74, 0x68, 0x72, 0x6f, 0x77, 0x73, 0x00, 0x07, 0x0a, 0x74, 0x68,
	0x72, 0x6f, 0x77, 0x73, 0x5f, 0x72, 0x65, 0x66, 0x00, 0x08, 0x0b, 0x68, 0x6f, 0x73, 0x74, 0x5f,
	0x74, 0x68, 0x72, 0x6f, 0x77, 0x73, 0x00, 0x09, 0x09, 0x08, 0x01, 0x03, 0x00, 0x04, 0x02, 0x03,
	0x04, 0x05, 0x0a, 0x6c, 0x08, 0x02, 0x00, 0x0b, 0x04, 0x00, 0x08, 0x00, 0x0b, 0x0f, 0x00, 0x02,
	0x69, 0x1f, 0x40, 0x01, 0x03, 0x00, 0x08, 0x00, 0x0b, 0x00, 0x0b, 0x0a, 0x0b, 0x04, 0x00, 0x10,
	0x01, 0x0b, 0x0b, 0x00, 0xd2, 0x02, 0xe0, 0x01, 0xe3, 0x01, 0x00, 0x10, 0x00, 0x0b, 0x15, 0x00,
	0x02, 0x40, 0x1f, 0x40, 0x01, 0x00, 0x00, 0x00, 0xd2, 0x03, 0xe0, 0x01, 0xe3, 0x01, 0x00, 0x0b,
	0x0b, 0x10, 0x00, 0x0b, 0x15, 0x00, 0x02, 0x40, 0x1f, 0x40, 0x01, 0x00, 0x00, 0x00, 0xd2, 0x04,
	0xe0, 0x01, 0xe3, 0x01, 0x00, 0x0b, 0x0b, 0x10, 0x00, 0x0b, 0x15, 0x00, 0x02, 0x40, 0x1f, 0x40,
	0x01, 0x00, 0x00, 0x00, 0xd2, 0x05, 0xe0, 0x01, 0xe3, 0x01, 0x00, 0x0b, 0x0b, 0x10, 0x00, 0x0b
];
