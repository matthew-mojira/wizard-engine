component X86_64LinuxExeTest {
	new() {
		for (strategy in [
			("spc:aot:", X86_64SpcAotStrategy.new(false)),
			("spc:lazy:", X86_64SpcLazyStrategy.new()),
			("int:dyn:", X86_64DynamicStrategy.new())]) {

			var newTester = ExeTester.new(_, strategy.1);
			for (test in [
				("empty", test_empty),
				("unreachable", test_unreachable),
				("i32.add", test_i32_add),
				("load_oob0", test_load_oob0),
				("call1005", test_call1005),		// intended to trigger OSR
				("shared_reg_merge", test_shared_reg_merge),
				("path_br_if1", test_path_br_if1),
				("path_br_if0", test_path_br_if0),
				("path_if1", test_path_if1),
				("path_if0", test_path_if0),
				("path_br_table0", test_path_br_table0),
				("path_br_tableN", test_path_br_tableN),
				("path_probe", test_path_probe)
				]) {
				// register strategy/test pair
				UnitTests.registerT(strategy.0, test.0, newTester, test.1);
			}
		}
		// a path profile is only ever gathered in the interpreter
		var newInt = ExeTester.new(_, X86_64InterpreterOnlyStrategy.new());
		for (test in [
			("ifs", test_profile_ifs),
			("br_table", test_profile_br_table),
			("loop", test_profile_loop)
			]) {
			UnitTests.registerT("pathprofile:", test.0, newInt, test.1);
		}
	}

}

// Tests specific compilation strategies such as AOT, lazy, dynamic tier up.
def X: Array<Value>;
def NONE = BpTypeCode.EmptyBlock.code;

def test_empty(i: ExeTester) {
	i.sig(SigCache.v_v).code([])
		.noargs().assert2_none();
}

def test_unreachable(i: ExeTester) {
	i.code([u8.!(Opcode.UNREACHABLE.code)])
		.noargs().assert2_trap(TrapReason.UNREACHABLE);
}

def test_nop(i: ExeTester) {
	i.sig(SigCache.v_v).code([u8.!(Opcode.NOP.code)])
		.noargs().assert2_none();
}

def test_i32_add(i: ExeTester) {
	i.sig(SigCache.ii_i).code([
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.LOCAL_GET.code), 1,
		u8.!(Opcode.I32_ADD.code)]);
	i.args_ii(0xFF89520F, 9999999).assert2_i(2222222);
}

def test_load_oob0(i: ExeTester) {
	i.addMemory(0, Max.Set(0));
	i.sig(SigCache.i_i);
	i.code([u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.I32_LOAD.code), 0, 0]);
	i.args_i(0).assert2_trap(TrapReason.MEMORY_OOB);
}

def test_shared_reg_merge(i: ExeTester) {
	i.sig(SigCache.i_i).codev([
		u8.!(Opcode.BLOCK.code), BpTypeCode.I32.code,
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.F64_CONVERT_I32_S.code),	// pops a register the local still shares
		u8.!(Opcode.I32_TRUNC_F64_S.code),	// the value the branch carries
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.BR_IF.code), 0,
		u8.!(Opcode.DROP.code),
		u8.!(Opcode.I32_CONST.code), 5,
		u8.!(Opcode.END.code)
	]);
	i.args_i(7).assert2_i(7);
	i.args_i(0).assert2_i(5);
}

// Runs {code} specialized to the path whose blocks start at {pcs}. {on} is an (argument, result)
// that follows the path and {off} one that fails a guard and so must tier down.
def check_path(i: ExeTester, code: Array<byte>, pcs: Array<int>, on: (int, int), off: (int, int)) {
	CompilerOptions.STRAIGHTLINE.val = List.new((i.func.func_index, pcs), null);
	i.sig(SigCache.i_i).codev(code);
	// dyn stays in the interpreter this briefly, so it never reaches a guard
	var after = Metrics.spc_tierdowns.val + if(X86_64DynamicStrategy.?(i.tiering), 0u, 1u);
	i.args_i(off.0).assert2_i(off.1);
	i.t.assert_eq(after, Metrics.spc_tierdowns.val);
	i.args_i(on.0).assert2_i(on.1);
	i.t.assert_eq(after, Metrics.spc_tierdowns.val);
	CompilerOptions.STRAIGHTLINE.val = null;
}

def PATH_BR_IF: Array<byte> = [
	u8.!(Opcode.BLOCK.code), NONE,
	u8.!(Opcode.LOCAL_GET.code), 0,
	u8.!(Opcode.BR_IF.code), 0,
	u8.!(Opcode.I32_CONST.code), 11,
	u8.!(Opcode.RETURN.code),
	u8.!(Opcode.END.code),
	u8.!(Opcode.I32_CONST.code), 22];

def test_path_br_if1(i: ExeTester) {
	check_path(i, PATH_BR_IF, [1, 10, 13], (5, 22), (0, 11)); // taken
}
def test_path_br_if0(i: ExeTester) {
	check_path(i, PATH_BR_IF, [1, 7, 13], (0, 11), (5, 22)); // fallthrough
}

def PATH_IF: Array<byte> = [
	u8.!(Opcode.LOCAL_GET.code), 0,
	u8.!(Opcode.IF.code), BpTypeCode.I32.code,
	u8.!(Opcode.I32_CONST.code), 11,
	u8.!(Opcode.ELSE.code),
	u8.!(Opcode.I32_CONST.code), 22,
	u8.!(Opcode.END.code)];

def test_path_if1(i: ExeTester) {
	check_path(i, PATH_IF, [1, 5, 10, 11], (5, 11), (0, 22)); // then
}
def test_path_if0(i: ExeTester) {
	check_path(i, PATH_IF, [1, 8, 10, 11], (0, 22), (5, 11)); // else
}

def PATH_BR_TABLE: Array<byte> = [
	u8.!(Opcode.BLOCK.code), NONE,
	u8.!(Opcode.BLOCK.code), NONE,
	u8.!(Opcode.LOCAL_GET.code), 0,
	u8.!(Opcode.BR_TABLE.code), 1, 0, 1,
	u8.!(Opcode.END.code),
	u8.!(Opcode.I32_CONST.code), 11,
	u8.!(Opcode.RETURN.code),
	u8.!(Opcode.END.code),
	u8.!(Opcode.I32_CONST.code), 22];

def test_path_br_table0(i: ExeTester) {
	check_path(i, PATH_BR_TABLE, [1, 11, 18], (0, 11), (5, 22)); // label 0
}
def test_path_br_tableN(i: ExeTester) {
	check_path(i, PATH_BR_TABLE, [1, 15, 18], (5, 22), (0, 11)); // default
}

// A probe on a failing guard fires once, not again in the interpreter.
def test_path_probe(i: ExeTester) {
	CompilerOptions.STRAIGHTLINE.val = List.new((i.func.func_index, [1, 10, 13]), null);
	i.sig(SigCache.i_i).codev(PATH_BR_IF);
	var count = CountProbe.new();
	Instrumentation.insertLocalProbe(i.module, i.func.func_index, 5, count); // the br_if
	i.args_i(0).assert2_i(11);
	i.t.assert_eq(1uL, count.count);
	CompilerOptions.STRAIGHTLINE.val = null;
}

// (sum, max, how many are nonzero) of a profile's path counts
def tally(counts: Array<int>) -> (int, int, int) {
	var sum = 0, max = 0, nonzero = 0;
	for (c in counts) {
		sum += c;
		if (c > max) max = c;
		if (c > 0) nonzero++;
	}
	return (sum, max, nonzero);
}

// Three decisions in a row make eight paths, which eight inputs take once each.
def test_profile_ifs(i: ExeTester) {
	var code = Vector<byte>.new();
	for (bit in [1, 2, 4]) code.puta([
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.I32_CONST.code), byte.!(bit),
		u8.!(Opcode.I32_AND.code),
		u8.!(Opcode.IF.code), NONE,
		u8.!(Opcode.NOP.code),
		u8.!(Opcode.END.code)]);
	code.puta([u8.!(Opcode.I32_CONST.code), 7]);
	i.sig(SigCache.i_i).codev(code.extract());
	var profile = SpcPathProfile.new(i.module, i.func);
	i.t.asserti(8, profile.counts.length);
	i.t.assert(profile.hottest() == null, "a path before any ran");
	for (x < 8) i.args_i(x).assert2_i(7);
	i.t.assert_eq((8, 1, 8), tally(profile.counts));
	for (n < 3) i.args_i(5).assert2_i(7);
	i.t.assert_eq((11, 4, 8), tally(profile.counts));
	// 5 takes the first and third `if`, which are at +6 and +24, and skips the one at +15
	var arms = profile.hottest();
	i.t.assert_eq((1, 0, 1), (arms[6], arms[15], arms[24]));
	profile.remove();
	i.args_i(5).assert2_i(7);
	i.t.assert_eq((11, 4, 8), tally(profile.counts));
}

// One label and the default make two paths.
def test_profile_br_table(i: ExeTester) {
	i.sig(SigCache.i_i).codev(PATH_BR_TABLE);
	var profile = SpcPathProfile.new(i.module, i.func);
	i.t.asserti(2, profile.counts.length);
	for (x in [0, 5, 5, 9]) i.args_i(x).assert2_i(if(x == 0, 11, 22));
	i.t.assert_eq((4, 3, 2), tally(profile.counts));
	i.t.asserti(1, profile.hottest()[7]); // the default, at the br_table at +7
}

// Each trip around a loop ends one path and starts the next, and none of those pieces is a
// route through the function. Only a call that never takes the backedge follows a whole path.
def test_profile_loop(i: ExeTester) {
	i.sig(SigCache.i_i).codev([
		u8.!(Opcode.LOOP.code), NONE,
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.I32_CONST.code), 1,
		u8.!(Opcode.I32_AND.code),
		u8.!(Opcode.IF.code), NONE,
		u8.!(Opcode.NOP.code),
		u8.!(Opcode.END.code),
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.I32_CONST.code), 1,
		u8.!(Opcode.I32_SUB.code),
		u8.!(Opcode.LOCAL_TEE.code), 0,
		u8.!(Opcode.BR_IF.code), 0,
		u8.!(Opcode.END.code),
		u8.!(Opcode.I32_CONST.code), 7]);
	var profile = SpcPathProfile.new(i.module, i.func);
	i.args_i(6).assert2_i(7);
	i.t.asserti(6, tally(profile.counts).0);
	i.t.assert(profile.hottest() == null, "a piece of a loop as a path");
	for (n < 10) i.args_i(1).assert2_i(7);
	i.t.asserti(16, tally(profile.counts).0);
	// the `if` at +8 is taken and the br_if at +19 is not
	var arms = profile.hottest();
	i.t.assert_eq((1, 0), (arms[8], arms[19]));
}

def test_call1005(i: ExeTester) {
	var f17 = byte.!(i.newFunction(SigCache.v_i, [u8.!(Opcode.I32_CONST.code), 17]).func_index);
	i.sig(SigCache.i_i);
	i.codev([
		u8.!(Opcode.LOOP.code), BpTypeCode.EmptyBlock.code,
		u8.!(Opcode.CALL.code), f17,
		u8.!(Opcode.LOCAL_GET.code), 0,
		u8.!(Opcode.I32_CONST.code), 1,
		u8.!(Opcode.I32_SUB.code),
		u8.!(Opcode.LOCAL_TEE.code), 0,
		u8.!(Opcode.I32_EQZ.code),
		u8.!(Opcode.BR_IF.code), 1,
		u8.!(Opcode.BR.code), 0,
		u8.!(Opcode.END.code),
		u8.!(Opcode.UNREACHABLE.code)
	]);
	i.args_i(5).assert2_i(17);
	i.args_i(1000).assert2_i(17);
}

